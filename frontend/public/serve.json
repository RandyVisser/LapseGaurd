{
  "cleanUrls": ["/"],
  "redirects": [
    { "source": "/security", "destination": "/security.html", "type": 301 }
  ],
  "directoryListing": false,
  "rewrites": [{ "source": "/:path+", "destination": "/app.html" }],
  "headers": [
    {
      "source": "assets/**/*.@(js|css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "assets/**/*.@(png|svg|jpg|jpeg|webp|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "@(index|app).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "guides/**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "security.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
